#!/usr/bin/env bash
# Pre-commit hook: refuse a commit that stages a JS file that does not parse.
#
# Run by the machine's global hooks dispatcher. Don't set core.hooksPath in
# the repo: a local value overrides the global hooks and skips the push guard.
#
# Eve has no bundler/build step (vanilla JS, direct browser execution), so the
# gate is a per-file syntax parse (node --check), not a compile.

set -e

cd "$(git rev-parse --show-toplevel)"

# Added/Copied/Modified only: skip deletes. Source filenames have no spaces.
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|cjs|mjs)$' || true)
if [ -z "$files" ]; then
    exit 0
fi

echo "→ node --check (staged JS)"
for f in $files; do
    if [ -f "$f" ] && ! node --check "$f"; then
        echo "✗ syntax error in $f; commit aborted"
        exit 1
    fi
done

echo "✓ pre-commit checks passed"
