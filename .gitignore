**/node_modules/*
# The pattern above only ignores a real directory's contents — a worktree's
# node_modules is sometimes a symlink (e.g. to another worktree's, to skip a
# reinstall), which that pattern doesn't match at all. This one covers both.
**/node_modules
*/.env
.env
.env.local
!.env.example
**/.DS_Store
**/.idea
**/.thumbs.db
**/.vscode
*.log

data/
certs/
coverage/

# Generated Kokoro voice packs for on-device TTS (run scripts/generate-voice-packs.py)
public/kokoro-voices/*.bin
plans/
e2e/.test-env.json
test-results/
test/fixtures/
playwright-report/
.playwright-cli/
relay-device.log

# Visual-regression run output (only __baseline__ is source)
test/visual/__current__/
test/visual/__diff__/
